# Reproducibility: exact versions, refuse unsupported Node, no network chatter during install.
save-exact=true
engine-strict=true
fund=false
audit=false
# npm 10's resolver crashes ("reading 'edgesOut'") on an optional peer conflict: test-only jsdom ->
# @exodus/bytes wants @noble/hashes ^1.8||^2, while ethers pins 1.3.2. Ignoring peer ranges is safe
# here because every Angular package we need is a direct, pinned dependency. Revisit on npm >= 11.
legacy-peer-deps=true
