{
  "name": "@sourcify/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Sourcify certificate registry (Solidity, Hardhat network, Mocha/Chai)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node --hostname 127.0.0.1 --port 7545",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "seed": "hardhat run scripts/seed.js --network localhost",
    "slither": "slither . --config-file slither.config.json"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@openzeppelin/contracts": "5.6.1",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "solc": "0.8.24"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "adm-zip": "0.6.1",
    "undici": "6.29.0",
    "tmp": "0.2.7",
    "serialize-javascript": "7.1.2"
  },
  "allowScripts": {
    "keccak@3.0.4": true,
    "secp256k1@4.0.5": true
  }
}
